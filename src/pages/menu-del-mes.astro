---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'menu-del-mes');
if (!page) throw new Error('Pàgina no trobada');
const { Content } = await render(page);
---

<!doctype html>
<html lang="ca">
	<head>
		<BaseHead title={`${page.data.title} | ${SITE_TITLE}`} description={page.data.description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{page.data.title}</h1>
				<p class="description">{page.data.description}</p>
			</section>

			<article class="prose">
				<div class="content">
					<Content />
					<!-- Cache-busting per assegurar que es veu l'última versió -->
					<div class="menu-container">
						<iframe
							src={`/uploads/menjador.pdf?v=${new Date().getTime()}`}
							title="Menú del mes de l'escola Ítaca"
						></iframe>
						<a class="download-link" href={`/uploads/menjador.pdf?v=${new Date().getTime()}`} target="_blank">
							Descarrega el PDF del menú
						</a>
					</div>
				</div>
				<div class="back-link">
					<a href="/comissions/menjador">← Torna a la Comissió de Menjador</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}
	.content {
		max-width: 960px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		text-align: center;
	}
	@media (max-width: 720px) {
		.content {
			padding: 1.5rem 0.75rem;
		}
	}
	/* Estils específics per al PDF del menú */
	.menu-container {
		margin: 2rem 0;
	}
	.menu-container iframe {
		width: 100%;
		height: 80vh;
		max-height: 1100px;
		border: 5px solid white;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		background: white;
	}
	.download-link {
		display: inline-block;
		margin-top: 1rem;
		color: var(--accent-dark);
		text-decoration: none;
		font-weight: 600;
	}
	.download-link:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	@media (max-width: 720px) {
		.menu-container iframe {
			height: 70vh;
		}
	}
	.prose {
		width: 100%;
		max-width: none;
		color: rgb(var(--gray-dark));
	}
	.back-link {
		max-width: 960px;
		margin: 2rem auto;
		padding: 0 2rem 4rem;
		text-align: center;
	}
	.back-link a {
		color: var(--accent-dark);
		text-decoration: none;
		font-weight: 600;
	}
</style>
